{
  "name": "lanes-cli",
  "version": "0.2.0",
  "description": "Run coding agents side by side, each lane in its own git worktree",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lanes": "./dist/bin/lanes.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-clonedir.mjs && node tools/build-bin-mode.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node ./dist/bin/lanes.js",
    "dev": "tsx ./src/bin/lanes.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "lanes-plugin-api": "file:../plugins/api"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
